NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://seatspace:change-this@localhost:5432/seatspace
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=seatspace
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
SEED_STUDENT_EMAIL=student@example.test
SEED_STUDENT_PASSWORD=change-this-student-password
CHECK_IN_GRACE_MINUTES=10
